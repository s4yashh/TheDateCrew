# Signing secret for the HTTP-only session cookie.
# Production refuses to start unless this is at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-value

# Google Gemini (free tier). Used only for introduction drafts and
# "Why this match?" explanations. Without it the app uses reviewed templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Neon Postgres. Leave empty to use the local .data JSON store.
# On Vercel, the Neon integration injects this automatically.
DATABASE_URL=

# Optional: point the local file store at another directory.
DATA_DIR=
